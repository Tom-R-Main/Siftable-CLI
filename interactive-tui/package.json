{
  "name": "@siftable/interactive-tui",
  "private": true,
  "type": "module",
  "description": "Bun/opentui TUI spawned by `sift interactive` (runs the OpenFunction brain in-process)",
  "scripts": {
    "test": "bun test",
    "native:build": "./scripts/build-native.sh",
    "native:test": "zig build test",
    "native:bench": "zig build bench -Dbench-optimize=ReleaseFast",
    "native:bench:build": "zig build bench-install -Dbench-optimize=ReleaseFast",
    "probe:code-search": "bun scripts/probe-code-search.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.3.1",
    "@opentui/solid": "^0.3.1",
    "@opentui/keymap": "^0.3.1",
    "solid-js": "^1.9.10"
  }
}
