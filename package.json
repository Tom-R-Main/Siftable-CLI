{
  "name": "@siftable/cli",
  "version": "0.5.29",
  "description": "Siftable CLI — human planning tasks, executable agent work queues, knowledge, and automation tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sift": "bin/run.js",
    "siftable": "bin/run.js",
    "exf": "bin/run.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "manifest": "oclif manifest",
    "interactive:dev": "npm run build && npm run manifest && (cd interactive-tui && bun run native:build) && node ./bin/run.js interactive",
    "interactive:help": "npm run build && npm run manifest && node ./bin/run.js interactive --help",
    "interactive:image-fixtures": "node scripts/create-interactive-image-fixtures.mjs",
    "bench:tui-actions": "tsx scripts/bench-tui-actions.ts",
    "explorer:eval": "tsx scripts/eval-repo-explorer.ts",
    "test": "jest",
    "test:vitest": "vitest run --config vitest.config.ts",
    "native:release": "cd interactive-tui && bash scripts/build-native-release.sh",
    "verify:package": "node scripts/verify-package-imports.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build && npx oclif manifest && npm run native:release && npm run verify:package"
  },
  "oclif": {
    "bin": "sift",
    "dirname": "siftable",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "auth": {
        "description": "Authentication commands"
      },
      "tasks": {
        "description": "Human planning tasks"
      },
      "projects": {
        "description": "Project management"
      },
      "notes": {
        "description": "Knowledge notes"
      },
      "calendar": {
        "description": "Calendar events"
      },
      "people": {
        "description": "People and contacts"
      },
      "organizations": {
        "description": "Organizations and companies"
      },
      "codebase": {
        "description": "Code indexing and search"
      },
      "code": {
        "description": "Code tools"
      },
      "code:memory": {
        "description": "Code memory and facts"
      },
      "vault": {
        "description": "Secrets vault"
      },
      "datasets": {
        "description": "Structured datasets"
      },
      "timeline": {
        "description": "Timeline facts and narratives"
      },
      "events": {
        "description": "Research events backed by timeline facts"
      },
      "graph": {
        "description": "Entity graph search and neighborhoods"
      },
      "documents": {
        "description": "Document upload"
      },
      "agents": {
        "description": "Agent aliases"
      },
      "work": {
        "description": "Executable agent work queue"
      },
      "worker": {
        "description": "Local executable work runners"
      },
      "skills": {
        "description": "Installable Siftable skillpacks"
      },
      "recipes": {
        "description": "Built-in research workflow recipes"
      },
      "research": {
        "description": "Research workflow planning and orchestration"
      },
      "evidence": {
        "description": "Evidence Graph setup and proof workflow orchestration"
      },
      "evidence:diff": {
        "description": "Evidence Graph diff plan review"
      },
      "evidence:sources": {
        "description": "Evidence Graph source ledger commands"
      },
      "evidence:proof": {
        "description": "Evidence Graph proof reports"
      },
      "codex": {
        "description": "Codex automation helpers"
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@morphllm/morphsdk": "^0.2.177",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@opentui/core": "^0.3.1",
    "@opentui/keymap": "^0.3.1",
    "@opentui/solid": "^0.3.1",
    "@siftable/mcp-server": "^1.2.15",
    "pg": "^8.20.0",
    "sharp": "^0.34.4",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "nock": "^13.5.0",
    "oclif": "^4",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "siftable",
    "ai",
    "tasks",
    "calendar",
    "knowledge-base",
    "agents"
  ],
  "author": "Siftable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tom-R-Main/Siftable-CLI.git"
  },
  "homepage": "https://github.com/Tom-R-Main/Siftable-CLI#readme",
  "bugs": {
    "url": "https://github.com/Tom-R-Main/Siftable-CLI/issues"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "oclif.manifest.json",
    "interactive-tui/*.ts",
    "interactive-tui/*.tsx",
    "interactive-tui/*.toml",
    "interactive-tui/build.zig",
    "interactive-tui/native/*.ts",
    "interactive-tui/native/*.zig",
    "interactive-tui/native/lib*.dylib",
    "interactive-tui/native/lib*.so",
    "interactive-tui/native/lib*.dll",
    "interactive-tui/native/cell-render",
    "interactive-tui/scripts/build-native.sh",
    "interactive-tui/scripts/build-native-release.sh",
    "interactive-tui/planning/**/*",
    "interactive-tui/assets/**/*",
    "interactive-tui/skills/**/*",
    "interactive-tui/openfunction/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
